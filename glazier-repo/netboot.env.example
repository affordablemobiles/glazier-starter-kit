# ==============================================================================
# netboot.env.example
# Copy this file to 'netboot.env' (which is gitignored) and customize your URLs.
# update-netboot.sh automatically sources netboot.env if present.
# ==============================================================================

# Base URL where iPXE configuration files are hosted (boot.ipxe, wimboot, logo.png)
BUCKET_URL="https://storage.googleapis.com/CHANGE_ME_CONFIG_BUCKET"

# Production WinPE boot files URL (contains Boot/BCD, Boot/boot.sdi, sources/boot.wim)
BOOT_URL="https://storage.googleapis.com/CHANGE_ME_BOOT_BUCKET"

# Development WinPE boot files URL (optional, for testing dev images)
BOOT_DEV_URL="https://storage.googleapis.com/CHANGE_ME_BOOT_DEV_BUCKET"
