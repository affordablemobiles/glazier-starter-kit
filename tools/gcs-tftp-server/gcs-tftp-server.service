[Unit]
Description=Stateless Google Cloud Storage TFTP Relay for iPXE Network Boot
Documentation=https://github.com/affordablemobiles/glazier-starter-kit/tree/master/tools/gcs-tftp-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/gcs-tftp-server
ExecStart=/usr/local/bin/gcs-tftp-server
Restart=on-failure
RestartSec=3s

# Run as an unprivileged ephemeral user with only CAP_NET_BIND_SERVICE for UDP/69
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
